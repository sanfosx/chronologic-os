generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  displayName  String?
  timezone     String        @default("America/Argentina/Buenos_Aires")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     Project[]
  tasks        Task[]
  events       Event[]
  habits       Habit[]
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  objective   String?
  priority    Int           @default(3)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  events      Event[]
  @@index([userId, status])
}

model Task {
  id                String       @id @default(cuid())
  userId            String
  projectId         String?
  title             String
  description       String?
  priority          Int          @default(3)
  status            TaskStatus   @default(TODO)
  dueDate           DateTime?
  estimatedMinutes  Int?
  energyRequired    EnergyLevel  @default(MEDIUM)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, status])
  @@index([projectId])
  @@index([dueDate])
}

model Event {
  id          String        @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  category    EventCategory @default(PERSONAL)
  priority    Int           @default(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, startsAt])
}

model Habit {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  target      Int?
  durationMin Int?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  records     HabitRecord[]
  @@index([userId, active])
}

model HabitRecord {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(false)
  value     Int?
  notes     String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, date])
  @@index([habitId, date])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum EventCategory {
  WORK
  FAMILY
  PERSONAL
  EXERCISE
  PROJECT
  REST
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}
